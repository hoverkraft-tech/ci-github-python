{
  "name": "ci-github-python-validation",
  "private": true,
  "description": "Development-only tests for GitHub Actions configuration",
  "scripts": {
    "test": "node --test tests/*.test.cjs actions/*/*.test.cjs",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=coverage/junit.xml",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync('coverage', {recursive:true})\""
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
